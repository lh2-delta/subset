# Copy to .env and adjust as needed.

# Host port for the browser UI
UI_PORT=8768

# Host folder holding the git clones you want to sample. Inside the UI use /data/repos.
LOCAL_REPOS_DIR=./repos

# Optional: only sample these repos (comma separated; org/repo or bare repo name).
# Used by the CLI when no --repo is given. The UI uses its own checkboxes.
SAMPLE_REPOS=

# Bitbucket Data Center base URL, e.g. https://bitbucket.example.com (prefills the UI;
# the token goes in the UI, in secrets/tokens as bitbucket_dc_token=..., or BITBUCKET_DC_TOKEN).
BITBUCKET_DC_URL=
